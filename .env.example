# Atelier 智能助手 — 本地实训演示配置模板
# 复制为 .env 后按需修改（勿提交真实密钥）

# --- 推荐：无真实 API 密钥时使用 Mock ---
USE_MOCK_PROVIDERS=true

# --- 鉴权（本地演示也建议设置随机 JWT_SECRET，≥32 字符）---
AUTH_ENABLED=true
JWT_SECRET=change-me-use-a-random-string-at-least-32-chars
USERS_DB_PATH=data/users.db

# --- 会话存储 ---
SESSION_STORE=memory
# SESSION_STORE=redis
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Agent ---
ENABLE_AGENT_PLANNING=true
AGENT_MAX_STEPS=10
ATTACHMENTS_DIR=data/attachments
ATTACHMENT_MAX_BYTES=5242880

# --- 知识库（需 Redis Stack 时取消注释）---
# KNOWLEDGE_ENABLED=true
# EMBEDDING_MODEL=doubao-embedding-vision-251215
# EMBEDDING_DIMENSIONS=2048

# --- 可选：网关二次校验（与 frontend VITE_API_KEY 一致）---
# API_KEY=

# --- 火山方舟（USE_MOCK_PROVIDERS=false 时填写）---
# ARK_API_KEY=
# LLM_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_CHAT_ENDPOINT_ID=ep-xxxxxxxx
# LLM_MODEL=doubao-seed-2-0-lite-260215
